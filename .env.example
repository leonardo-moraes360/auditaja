# Copie para apps/web/.env.local (Next.js) e .env na raiz (scripts de banco e coleta). Nunca commite segredos (R9).
DATABASE_URL=postgres://auditaja:auditaja@127.0.0.1:5436/auditaja

# Endereço público do site, sem barra final (canonical, sitemap, Open Graph, llms.txt).
# Lido no build: defina no ambiente de build do deploy. Sem ele, vale http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contato exibido no User-Agent dos coletores (R7).
AUDITAJA_CONTACT_URL=https://github.com/leonardo-moraes360/auditaja

# Identificação pública do responsável (R13). Placeholders até definição.
NEXT_PUBLIC_CONTROLADOR_NOME=[NOME DO CONTROLADOR]
NEXT_PUBLIC_CONTROLADOR_DOC=[CNPJ]
NEXT_PUBLIC_ENCARREGADO_NOME=[NOME DO ENCARREGADO]
NEXT_PUBLIC_ENCARREGADO_EMAIL=[E-MAIL DO ENCARREGADO]
